flowchart TD
  START([تشغيل البرنامج SecureVoice]) --> GUI[عرض الواجهة + عنوان IP للجهاز<br/>+ قائمة أجهزة الصوت]
  GUI --> CFG[المستخدم يختار: الوضع، كلمة السر،<br/>الخوارزمية، الترميز، الميكروفون والسماعة]
  CFG --> MODE{الوضع؟}
  MODE -- استقبال A --> LIS[فتح منفذ TCP 5000 والانتظار<br/>+ ربط UDP 5001]
  MODE -- اتصال B --> CON[الاتصال بـ IP الطرف الآخر:5000<br/>+ ربط UDP]
  LIS --> ACC[قبول الاتصال الوارد]
  ACC --> HS
  CON --> HS[المصافحة: X25519 + PBKDF2 + HKDF + Finished MAC]
  HS --> OK{نجحت المصادقة؟}
  OK -- لا --> ERR[❌ رسالة خطأ: كلمة سر خاطئة / MITM<br/>إغلاق الاتصال]
  ERR --> GUI
  OK -- نعم --> KEYS[اشتقاق مفاتيح الجلسة + عرض رمز الأمان SAS]
  KEYS --> MEDIA[تشغيل الخيوط: الإرسال / الاستقبال / الصوت / التحكم]
  MEDIA --> CALL[📞 مكالمة آمنة جارية<br/>تحديث الإحصائيات والرسوم كل 0.5 ثانية]
  CALL --> EVT{حدث؟}
  EVT -- رسالة نصية --> CHAT[تشفير وإرسال عبر قناة التحكم] --> CALL
  EVT -- كتم --> MUTE[إرسال صمت + إشعار MUTE] --> CALL
  EVT -- محاكاة هجوم --> ATK[إرسال حزم معدلة/مزورة/مكررة] --> CALL
  EVT -- إنهاء / BYE / انقطاع --> END[إرسال BYE مشفر، إيقاف الصوت،<br/>إغلاق المنافذ، حذف المفاتيح]
  END --> GUI
