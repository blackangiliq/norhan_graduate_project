flowchart TD
  R([استقبال حزمة UDP]) --> P{هل البنية صحيحة؟<br/>الطول ≥ 26 والإصدار = 1}
  P -- لا --> D1[إسقاط الحزمة<br/>malformed++]
  P -- نعم --> RW{نافذة منع التكرار:<br/>هل seq جديد؟}
  RW -- لا --> D2[⛔ رفض: هجوم إعادة إرسال<br/>replays_blocked++ وتنبيه]
  RW -- نعم --> N[حساب Nonce = IV_rx XOR seq]
  N --> DEC[🔓 فك التشفير والتحقق<br/>Ascon-128.Dec K_rx, Nonce, AD=Header, C‖Tag]
  DEC --> V{هل الوسم Tag صحيح؟}
  V -- لا --> D3[⛔ رفض: حزمة معدّلة أو مزوّرة<br/>auth_failures++ وتنبيه]
  V -- نعم --> UP[تحديث نافذة التكرار بـ seq]
  UP --> T{نوع الحزمة}
  T -- PING --> PO[إرسال PONG مشفر]
  T -- PONG --> RTT[حساب زمن الرحلة RTT]
  T -- VOICE --> J[حساب الارتعاش Jitter RFC 3550]
  J --> DC[فك ترميز الصوت → PCM]
  DC --> JB[إدخال في مخزن الارتعاش<br/>مرتب حسب رقم الإطار]
  JB --> PL[كرت الصوت يسحب إطاراً<br/>every 20 ms]
  PL --> MISS{هل الإطار موجود؟}
  MISS -- نعم --> SPK[🔊 تشغيل على السماعة]
  MISS -- لا --> PLC[إخفاء الفقد PLC<br/>تكرار الإطار السابق بصوت أخفض]
  PLC --> SPK
